#!/usr/bin/env bun
// Fake codex/claude. Plays one step of $FAKE_SCENARIO per invocation and logs its argv and stdin to $FAKE_LOG.
// Step keys: lines (events to print), sleep (seconds, after the lines), exit (code), report (codex: written to -o),
// holder (seconds a background child keeps stdout open after this process exits).
import { spawn } from "node:child_process";
import * as fs from "node:fs";

const argv = process.argv.slice(2);
if (argv[0] === "app-server") process.exit(1); // delegate must not register Desktop threads

const scenario = JSON.parse(fs.readFileSync(process.env.FAKE_SCENARIO, "utf8"));
const log = process.env.FAKE_LOG;
const count = fs.existsSync(log) ? fs.readFileSync(log, "utf8").trim().split("\n").length : 0;
const step = scenario[Math.min(count, scenario.length - 1)];
const stdin = fs.readFileSync(0, "utf8");
fs.appendFileSync(log, JSON.stringify({ argv, stdin, pid: process.pid }) + "\n");
for (const line of step.lines ?? []) fs.writeSync(1, JSON.stringify(line) + "\n");
if (step.report && argv.includes("-o")) fs.writeFileSync(argv[argv.indexOf("-o") + 1], JSON.stringify(step.report));
if (step.holder) spawn("/bin/sleep", [String(step.holder)], { stdio: ["ignore", "inherit", "ignore"], detached: true }).unref();
if (step.sleep) await Bun.sleep(step.sleep * 1000);
process.exit(step.exit ?? 0);
